    <string name="about_title">About</string>
    <string name="about_version">Sanjoy Money version %1$s</string>
    <string name="about_note">This bot never touches the Jaiho 777 APK. The game is not modified, not repackaged and not bundled. Sanjoy Money only reads the screen through Accessibility and taps like a fast finger. No root, no VPN, no proxy, no server. That is why the game and its server cannot detect it.</string>

    <string name="calibrate_title">Calibration</string>
    <string name="calibrate_body">1. Open Jaiho 777 through the home screen.\n2. Open the SM panel and tap the crosshair button.\n3. Drag the SPIN crosshair onto the real spin button and the COLLECT crosshair onto the real collect or claim button.\n4. Save. The points are stored as screen percentages and are used whenever Accessibility cannot find the buttons.</string>
    <string name="calibrate_open_panel">Start the bubble from the home screen to calibrate over the game</string>
    <string name="calibrate_now">Calibrate now</string>
    <string name="calibrate_need_overlay">Give the overlay permission first</string>
    <string name="calibrate_spin">SPIN</string>
    <string name="calibrate_collect">COLLECT</string>
    <string name="calibrate_save">Save points</string>
    <string name="calibrate_saved">Calibration saved</string>
    <string name="calibrate_current">Current points - spin %1$d%% / %2$d%%, collect %3$d%% / %4$d%%</string>
    <string name="calibrate_not_set">No calibration points yet</string>
    <string name="calibrate_drag_hint">Drag the gold SPIN crosshair onto the real spin button and the green COLLECT crosshair onto the collect or claim button, then save. Taps only fall back to these points when Accessibility cannot find the button.</string>
    <string name="calibrate_hint_pct">SPIN x %1$d%% / y %2$d%% - COLLECT x %3$d%% / y %4$d%%</string>

